    {"op": "encode", "in": ["param_set_many", [3, "gain", "loud"]], "error": true},
    {"op": "encode", "in": ["param_set_many", [3, "gain", 0.5, "level", 0.75]], "expect": "param_set_many 3 gain 0.5 level 0.75"},
