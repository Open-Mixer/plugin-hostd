{
  "about": "The requests and replies both protocol clients are tested on (docs/clients.md): each case an operation, its input and what it gives. \"error\": true is a refusal, whatever its message; a case without \"expect\" is held only to both clients giving the same (tests/clients_agree.py).",
  "cases": [
    {"op": "encode", "in": ["add", ["lv2:urn:example:gain", 3]], "expect": "add lv2:urn:example:gain 3"},
    {"op": "encode", "in": ["remove", [3]], "expect": "remove 3"},
    {"op": "encode", "in": ["param_set", [3, "gain", 0.25]], "expect": "param_set 3 gain 0.25"},
    {"op": "encode", "in": ["param_set", [3, "gain", 1.0]], "expect": "param_set 3 gain 1"},
    {"op": "encode", "in": ["param_set", [3, "gain", -0.5]], "expect": "param_set 3 gain -0.5"},
    {"op": "encode", "in": ["param_set", [3, "gain", 1e-7]], "expect": "param_set 3 gain 1e-7"},
    {"op": "encode", "in": ["param_set", [3, "gain", 0.1]], "expect": "param_set 3 gain 0.1"},
    {"op": "encode", "in": ["param_set", [3, "gain", 1e21]], "expect": "param_set 3 gain 1e+21"},
    {"op": "encode", "in": ["param_get", [3, ":bypass"]], "expect": "param_get 3 :bypass"},
    {"op": "encode", "in": ["bypass", [3, 1]], "expect": "bypass 3 1"},
    {"op": "encode", "in": ["preset_load", [3, "/home/user/my presets/a.json"]], "expect": "preset_load 3 \"/home/user/my presets/a.json\""},
    {"op": "encode", "in": ["preset_load", [3, "say \"hi\""]], "expect": "preset_load 3 \"say \\\"hi\\\"\""},
    {"op": "encode", "in": ["param_set", [3, "gain", "loud"]], "error": true},
    {"op": "encode", "in": ["param_set", [3.5, "gain", 0.25]], "error": true},
    {"op": "encode", "in": ["param_set", [3, "gain"]], "error": true},
    {"op": "encode", "in": ["no_such_verb", [1]], "error": true},
    {"op": "encode", "in": ["param_set", [3, "", 0.25]], "expect": "param_set 3 \"\" 0.25"},

    {"op": "decode", "in": "param_set 3 gain 0.25", "expect": {"verb": "param_set", "args": [3, "gain", 0.25]}},
    {"op": "decode", "in": "preset_load 3 \"/home/user/my presets/a.json\"", "expect": {"verb": "preset_load", "args": [3, "/home/user/my presets/a.json"]}},
    {"op": "decode", "in": "remove 3", "expect": {"verb": "remove", "args": [3]}},
    {"op": "decode", "in": "param_set three gain 0.25", "error": true},
    {"op": "decode", "in": "no_such_verb 1", "error": true},

    {"op": "parse", "in": "resp 0", "expect": {"kind": "resp", "code": 0, "data": []}},
    {"op": "parse", "in": "resp 3", "expect": {"kind": "resp", "code": 3, "data": []}},
    {"op": "parse", "in": "resp 0 0.2500", "expect": {"kind": "resp", "code": 0, "data": ["0.2500"]}},
    {"op": "parse", "in": "resp -103", "expect": {"kind": "resp", "code": -103, "name": "reply.host.param-symbol-invalid", "data": []}},
    {"op": "parse", "in": "resp -103 reply.host.param-symbol-invalid", "expect": {"kind": "resp", "code": -103, "name": "reply.host.param-symbol-invalid", "data": ["reply.host.param-symbol-invalid"]}},
    {"op": "parse", "in": "resp -104 PRESET_PLUGIN_CHANGED", "expect": {"kind": "resp", "code": -104, "data": ["PRESET_PLUGIN_CHANGED"]}},
    {"op": "parse", "in": "resp -544", "expect": {"kind": "resp", "code": -544, "name": "reply.plugin-hostd.preset-not-applied", "data": []}},
    {"op": "parse", "in": "@t7 resp 0 0.2500", "expect": {"kind": "resp", "tag": "t7", "code": 0, "data": ["0.2500"]}},
    {"op": "parse", "in": "#12 output_set 3 level 0.5", "expect": {"kind": "feedback", "seq": 12, "line": "output_set", "args": [3, "level", 0.5]}},
    {"op": "parse", "in": "output_set 3 level 0.5", "expect": {"kind": "feedback", "line": "output_set", "args": [3, "level", 0.5]}},
    {"op": "parse", "in": "not found", "expect": {"kind": "protocol_error", "code": -1, "name": "PROTOCOL_NOT_FOUND"}},
    {"op": "parse", "in": "few arguments", "expect": {"kind": "protocol_error", "code": -3, "name": "PROTOCOL_FEW_ARGUMENTS"}},
    {"op": "parse", "in": "resp x", "error": true},
    {"op": "parse", "in": "", "error": true},

    {"op": "words", "in": "add \"a b\" 3", "expect": ["add", "a b", "3"]},
    {"op": "words", "in": "x \"say \\\"hi\\\"\" y", "expect": ["x", "say \"hi\"", "y"]},
    {"op": "words", "in": "x \"never closed", "expect": ["x", "never closed"]},
    {"op": "words", "in": "  spaced   out  ", "expect": ["spaced", "out"]},
    {"op": "quote", "in": "a \"b\" c", "expect": "\"a \\\"b\\\" c\""},
    {"op": "encode_path", "in": "/usr/lib/clap/My Synth,v2=new.clap", "expect": "/usr/lib/clap/My%20Synth%2Cv2%3Dnew.clap"},
    {"op": "encode_path", "in": "/x/100%.clap", "expect": "/x/100%25.clap"},
    {"op": "encode_path", "in": "/x/café.clap", "expect": "/x/café.clap"},
    {"op": "decode_path", "in": "/usr/lib/clap/My%20Synth%2Cv2%3Dnew.clap", "expect": "/usr/lib/clap/My Synth,v2=new.clap"},
    {"op": "decode_path", "in": "/x/%G1", "error": true},
    {"op": "decode_path", "in": "/x/%2", "error": true},
    {"op": "uri_word", "in": "clap:/usr/lib/clap/My Synth.clap#org.example.synth", "expect": "clap:/usr/lib/clap/My%20Synth.clap#org.example.synth"},
    {"op": "uri_word", "in": "urn:example:gain", "expect": "urn:example:gain"},
    {"op": "pin_key", "in": "clap:/usr/lib/clap/My%20Synth.clap#org.example.synth", "expect": "clap:/usr/lib/clap/My Synth.clap#org.example.synth"},
    {"op": "pin_key", "in": "clap:/usr/lib/clap/My Synth.clap#org.example.synth", "expect": "clap:/usr/lib/clap/My Synth.clap#org.example.synth"},
    {"op": "pin_key", "in": "lv2:urn:x", "expect": "lv2:urn:x"},

    {"op": "code", "in": "reply.host.param-symbol-invalid", "expect": -103},
    {"op": "code", "in": "reply.plugin-hostd.preset-not-applied", "expect": -544},
    {"op": "code", "in": "reply.nowhere.unknown", "error": true},
    {"op": "name", "in": -103, "expect": "reply.host.param-symbol-invalid"},
    {"op": "name", "in": -999999, "expect": null},
    {"op": "sentence", "in": [-103, "en"]},
    {"op": "sentence", "in": [-103, "ca"]},
    {"op": "sentence", "in": [-544, "en"]},
    {"op": "sentence", "in": [-999999, "en"], "expect": null}
  ]
}
