    {"op": "encode", "in": ["param_set", [3, "gain", 1e-7]], "expect": "param_set 3 gain 1e-7"},
    {"op": "encode", "in": ["param_set", [3, "gain", 0.1]], "expect": "param_set 3 gain 0.1"},
    {"op": "encode", "in": ["param_set", [3, "gain", 1e21]], "expect": "param_set 3 gain 1e+21"},
