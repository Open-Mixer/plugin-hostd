# The documentation gate (tools/doxygen_gate.sh): doxygen warns for each public symbol of the module headers without a
# doc block, and for each parameter without @param. Nothing is generated.
PROJECT_NAME           = plugin-hostd
INPUT                  = src
FILE_PATTERNS          = *.h
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: warning: $text"
WARN_LOGFILE           = $(DOXYGEN_LOG)
# doxygen records a function's @param and @return only while it writes an output: with none it warns that every
# function's parameters and return are undocumented. So it writes HTML, plain, into the gate's scratch directory
# (DOXYGEN_OUT, which tools/doxygen_gate.sh makes and removes); the HTML is thrown away.
GENERATE_HTML          = YES
OUTPUT_DIRECTORY       = $(DOXYGEN_OUT)
HTML_OUTPUT            = html
SEARCHENGINE           = NO
HAVE_DOT               = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = YES
