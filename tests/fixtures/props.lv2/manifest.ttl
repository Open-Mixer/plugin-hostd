# The bundle of tests/daemon_test.py's property verbs on mod-host: a plugin whose file and text properties the daemon reads, no binary (the worker is a fake).
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:openmixer:test:props>
    a lv2:Plugin ;
    lv2:binary <props.so> ;
    rdfs:seeAlso <props.ttl> .
