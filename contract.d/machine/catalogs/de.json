    "MACHINE_ARCHES.aarch64": {"text": "Eine AArch64-Maschine, wie sie `uname -m` ausgibt.", "by": "machine", "model": "draft-prose", "source": "94f112f7fc8ba1efb070ced1b43fc1bd9c3370a0915da4d5213e4cf86b17beff"},
